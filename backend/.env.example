PORT=3000
CORS_ORIGIN=http://localhost:4200
# Ejecución local sin Docker (MySQL accesible en localhost:3306). Valores de ejemplo.
DATABASE_URL="mysql://tickets_user:cambiar_password@localhost:3306/tickets_db"
# Secreto para firmar JWT (mínimo 16 caracteres; use uno largo y aleatorio)
JWT_SECRET=cambiar_este_secreto_jwt_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h
# Contraseña que el seed asigna a los usuarios de demostración
SEED_PASSWORD=Demo1234!
