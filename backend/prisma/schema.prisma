// Modelo de datos - Sistema de Gestión de Tickets (Prisma 5.x + MySQL 8)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SOPORTE
  SOLICITANTE
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum Status {
  ABIERTO
  EN_PROGRESO
  RESUELTO
  CERRADO
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  passwordHash String @db.VarChar(255)
  role      Role     @default(SOLICITANTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedTickets Ticket[]        @relation("TicketRequester")
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  statusChanges    TicketHistory[]
}

model Ticket {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(150)
  description String   @db.Text
  category    String   @db.VarChar(60)
  priority    Priority @default(MEDIA)
  status      Status   @default(ABIERTO)
  requesterId Int
  assigneeId  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  history   TicketHistory[]

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([requesterId])
  @@index([assigneeId])
}

model TicketHistory {
  id             Int      @id @default(autoincrement())
  ticketId       Int
  previousStatus Status
  newStatus      Status
  changedById    Int?
  createdAt      DateTime @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([changedById])
}
