# Copie este archivo a ".env" y cambie los valores. NO suba ".env" al repositorio.
# Evite caracteres especiales (@ : / # ? %) en las contraseñas: se insertan en DATABASE_URL.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=tickets_db
MYSQL_USER=tickets_user
MYSQL_PASSWORD=Tickets123

# Puertos publicados en el equipo anfitrión
FRONTEND_PORT=8080
BACKEND_PORT=3000

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:8080

# true = ejecuta el seed de demostración (idempotente) al iniciar el backend
RUN_SEED=true

# Autenticación JWT. JWT_SECRET: mínimo 16 caracteres, largo y aleatorio (obligatorio).
JWT_SECRET=cambiar_este_secreto_jwt_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h
# Contraseña que el seed asigna a TODOS los usuarios de demostración
SEED_PASSWORD=Demo1234!

# Solo con docker-compose.mysql-local.yml
MYSQL_LOCAL_PORT=3307
